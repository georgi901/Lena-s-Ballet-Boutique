{
  "main": "server.js",
  "name": "proiect-tehnici-web",
  "description": "Lena's Ballet Boutique is an online shop for ballet equipment, costumes and accessories selected and personally recommended by a professional dancer. The site serves beginners, advanced dancers, professional performers and ballet schools.",
  "keywords": [
    "Lena's Ballet Boutique",
    "ballet",
    "ballet shoes",
    "ribbons",
    "tights",
    "ballet skirt",
    "hair net",
    "hair accessories",
    "tutu",
    "body",
    "poante",
    "online ballet shop",
    "ballet equipment",
    "classical dance accessories",
    "ballet costumes",
    "ballet products",
    "beginner ballet kit",
    "ballet schools"
  ],
  "author": "Spataru Georgiana Valentina",
  "scripts": {
    "start": "node server.js",
    "migrate": "node scripts/migrate.js",
    "build:scss": "sass --load-path=node_modules assets/scss:assets/css --style=expanded",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "dotenv": "^16.6.1",
    "ejs": "^5.0.1",
    "express": "^5.2.1",
    "pg": "^8.21.0",
    "sass": "^1.99.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "supertest": "^7.3.1",
    "vitest": "^4.1.11"
  }
}
