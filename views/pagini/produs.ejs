<!DOCTYPE html>
<html lang="ro">

<head>
    <%- include('../fragmente/head') %>
    <title><%= produs.nume %> | Lena's Ballet Boutique</title>
</head>

<body id="top">
    <%- include('../fragmente/header') %>

    <main class="pagina-produs">
        <section class="pagina-produs__hero">
            <p class="mb-2"><a class="btn btn-outline-primary" href="/produse?categorie=<%= produs.categorie %>"><i class="bi bi-arrow-left"></i> Înapoi la produse</a></p>
            <h2 class="mb-1"><%= produs.nume %></h2>
            <p class="pagina-produse__rezumat mb-0"><%= produs.categorie_eticheta %> · <%= produs.subcategorie %> · recomandat pentru nivel <%= produs.nivel_experienta %>/10</p>
            <% if (produs.esteProdusNou) { %>
                <p class="mt-3 mb-0"><span class="badge text-bg-success">NOU în ultimele <%= pragProdusNouZile %> zile</span></p>
            <% } %>
        </section>

        <section class="pagina-produs__grid">
            <article class="pagina-produs__card">
                <img class="pagina-produs__imagine" src="<%= produs.imagine %>" alt="<%= produs.nume %>">
                <p class="mt-3 mb-0"><%= produs.detalii %></p>
            </article>

            <article class="pagina-produs__card pagina-produs__detalii">
                <h3>Detalii complete</h3>
                <dl>
                    <dt>Preț</dt>
                    <dd><%= produs.pret.toFixed(2) %> lei</dd>

                    <dt>Categorie</dt>
                    <dd><%= produs.categorie_eticheta %></dd>

                    <dt>Subcategorie</dt>
                    <dd><%= produs.subcategorie %></dd>

                    <dt>Brand</dt>
                    <dd><%= produs.brand %></dd>

                    <dt>Nivel recomandat</dt>
                    <dd><%= produs.nivel_experienta %> / 10</dd>

                    <dt>Culoare</dt>
                    <dd><%= produs.culoare %></dd>

                    <dt>Materiale</dt>
                    <dd><%= produs.materiale_afisare %></dd>

                    <dt>Data adăugării</dt>
                    <dd><time datetime="<%= produs.data_adaugare_iso %>"><%= produs.data_adaugare_afisare %></time></dd>

                    <dt>Personalizabil</dt>
                    <dd><%= produs.personalizabil ? "Da" : "Nu" %></dd>

                    <dt>Stoc</dt>
                    <dd><%= produs.stoc %> bucăți</dd>

                    <dt>Recomandarea Lenei</dt>
                    <dd><%= produs.recomandare_lena %></dd>

                    <dt>Descriere completă</dt>
                    <dd><%= produs.descriere %></dd>

                    <dt>Întreținere</dt>
                    <dd><%= produs.intretinere %></dd>
                </dl>
            </article>
        </section>

        <% if (produseSimilare && produseSimilare.length) { %>
            <section class="produse-similare">
                <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 align-items-lg-center mb-3">
                    <div>
                        <h3 class="mb-1">Produse similare</h3>
                        <p class="mb-0 text-secondary">Am ales articole din aceeași categorie și cu profil apropiat de utilizare.</p>
                    </div>
                </div>

                <div class="produse-similare__grid">
                    <% for (let produsSimilar of produseSimilare) { %>
                        <article class="mini-produs card">
                            <img class="mini-produs__imagine" src="<%= produsSimilar.imagine %>" alt="<%= produsSimilar.nume %>">
                            <div class="card-body">
                                <div class="d-flex flex-wrap gap-2 mb-2">
                                    <% if (produsSimilar.esteProdusNou) { %>
                                        <span class="badge text-bg-success">Nou</span>
                                    <% } %>
                                    <% if (produsSimilar.esteCelMaiIeftin) { %>
                                        <span class="badge text-bg-warning">Cel mai bun preț</span>
                                    <% } %>
                                </div>
                                <h4 class="h5 mb-1"><a href="/produs/<%= produsSimilar.id %>"><%= produsSimilar.nume %></a></h4>
                                <p class="mb-2 text-secondary"><%= produsSimilar.subcategorie %> · nivel <%= produsSimilar.nivel_experienta %>/10</p>
                                <p class="mb-3"><%= produsSimilar.descriere %></p>
                                <p class="mb-0 fw-semibold"><%= produsSimilar.pret.toFixed(2) %> lei</p>
                            </div>
                        </article>
                    <% } %>
                </div>
            </section>
        <% } %>
    </main>

    <%- include('../fragmente/footer') %>
</body>

</html>
